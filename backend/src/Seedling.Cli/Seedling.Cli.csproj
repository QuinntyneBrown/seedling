<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Seedling.Cli</RootNamespace>
    <AssemblyName>seedling</AssemblyName>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>seedling</ToolCommandName>
    <PackageId>Seedling.Cli</PackageId>
    <Version>0.1.0</Version>
    <Description>Seedling CLI — database migration, seeding and reset.</Description>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Seedling.Infrastructure\Seedling.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Seedling.Cli.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Seed\Data\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>tools\net10.0\any\Seed\Data\</PackagePath>
    </None>
  </ItemGroup>
</Project>
