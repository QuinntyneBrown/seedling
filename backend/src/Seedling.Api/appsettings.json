{
  "ConnectionStrings": {
    "Seedling": "Server=(localdb)\\MSSQLLocalDB;Database=Seedling;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Seedling": {
    "Database": {
      "Provider": "SqlServer"
    },
    "Jwt": {
      "Issuer": "seedling",
      "Audience": "seedling-clients",
      "SigningKey": "REPLACE_VIA_SEEDLING_JWT_SIGNING_KEY_ENV",
      "AccessTokenMinutes": 15
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
