  "color": {
    "$type": "color",
    "forest": {
      "$value": "#123B2A",
      "$description": "Primary. Trust: wordmark, headings, dark surfaces, app icon background."
    },
    "sprout": {
      "$value": "#2E8049",
      "$description": "Primary. Growth: primary buttons, links, progress, the large leaf."
    },
    "mango": {
      "$value": "#F5A524",
      "$description": "Primary. Hope: dollar amounts, highlights, celebrations, the small leaf."
    },
    "leaf": {
      "$value": "#7CC47F",
      "$description": "Supporting. Sprout's partner on Forest backgrounds and in dark mode."
    },
    "hibiscus": {
      "$value": "#E4573D",
      "$description": "Supporting. Illustration accents, deadlines, moments of delight."
    },
    "cream": { "$value": "#FFF6E9", "$description": "Neutral. Default background." },
    "sand": {
      "$value": "#F1E3C8",
      "$description": "Neutral. Cards on cream, dividers, inactive states."
    },
    "ink": { "$value": "#16231C", "$description": "Neutral. Body copy. Never use pure black." }
  },
