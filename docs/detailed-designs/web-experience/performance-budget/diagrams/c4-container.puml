@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Performance budget

Person(parent, "Parent", "Opens and tracks an RESP for each child")
System_Boundary(seedlings, "Seedlings") {
  Container(pwa, "Seedlings PWA", "Angular 21, service worker", "Parent-facing progressive web app (frontend/projects/seedling); initial JS under 300 KB gzipped")
  Container(api, "Seedlings API", "ASP.NET Core, .NET 10", "Controllers, MediatR application layer, domain")
  Container(worker, "Seedlings Worker", ".NET 10 triggered WebJob", "Scheduled daily checks and reminders; deferred agent work")
  ContainerDb(db, "Seedlings database", "Azure SQL", "Accounts, cases, intake, audit trail")
}
System_Ext(appinsights, "Application Insights", "Telemetry and logs")
System_Ext(ci, "GitHub Actions CI", "Runs size:check and Lighthouse; load test on a schedule")
Rel(parent, pwa, "Loads", "HTTPS")
Rel(pwa, api, "Case list p95 < 500 ms; intake save p95 < 300 ms", "JSON/HTTPS")
Rel(api, db, "Indexed reads and single-row upserts", "EF Core")
Rel(worker, db, "Runs deferred work", "EF Core")
Rel(api, appinsights, "Exports timings", "OpenTelemetry")
Rel(ci, pwa, "Measures build size and Lighthouse TTI and score")
Rel(ci, api, "Drives 50 virtual parents for 5 minutes", "HTTPS")
@enduml
