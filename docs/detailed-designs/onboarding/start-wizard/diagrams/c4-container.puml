@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Start the onboarding wizard

Person(parent, "Parent", "Opens and tracks an RESP for each child")
System_Boundary(seedlings, "Seedlings") {
  Container(pwa, "Seedlings PWA", "Angular 21, service worker", "Parent-facing progressive web app (frontend/projects/seedling)")
  Container(api, "Seedlings API", "ASP.NET Core, .NET 10", "Controllers, MediatR application layer, domain")
  ContainerDb(db, "Seedlings database", "Azure SQL", "Accounts, cases, intake, audit trail")
}
System_Ext(appinsights, "Application Insights", "Telemetry and logs")

Rel(parent, pwa, "Reads the welcome screen, taps Start and Finish", "HTTPS")
Rel(pwa, api, "GET /api/wizard, POST /api/wizard, POST /api/wizard/finish", "JSON/HTTPS")
Rel(api, db, "Reads and writes WizardProgress, Child, RespCase", "EF Core")
Rel(api, appinsights, "Sends telemetry", "HTTPS")
@enduml
