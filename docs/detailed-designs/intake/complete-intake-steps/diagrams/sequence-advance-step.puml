@startuml
title UML sequence behaviour — Advance to the next intake step
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as actor
box "Frontend — Seedlings PWA" #E0F2FE
  participant "Intake step page" as page
  participant "IntakeFlowStore" as store
  participant "HttpIntakeService" as client
end box
box "Backend — Seedlings API application" #D1FADF
  participant "IntakeController" as controller
end box
box "Backend — Seedlings Application and Domain" #ECFDF3
  participant "AdvanceIntakeStepCommandHandler" as handler
  participant "IntakeStepPlanner" as planner
end box
box "Backend — Seedlings Infrastructure" #FFF4E5
  database "Seedlings database" as db
end box
actor -> page : Tap Continue
page -> store : advance(stepKey)
store -> client : advance(stepKey, caseId)
client -> controller : POST /api/intake/steps/{stepKey}/advance
controller -> handler : Send AdvanceIntakeStepCommand
handler -> db : Load IntakeField rows, EligibilityAnswers, WizardProgress
db --> handler : State
handler -> handler : Check each RequiredField of the step
alt a required field is empty
  handler --> controller : ValidationException(field -> plain-language message)
  controller --> client : 400 ValidationProblemDetails
  client --> store : Missing fields
  store --> page : Highlight field, aria-invalid, name what is missing; stay on step (L2-014 AC2)
else all required fields present
  handler -> planner : Next(stepKey, Plan(answers))
  alt step is ParentSin and EligibilityAnswers says no RESP exists
    planner --> handler : Contact (ExistingResp skipped, L2-014 AC3)
  else otherwise
    planner --> handler : Next step in L2-014 order
  end
  handler -> db : Update WizardProgress(CurrentStepKey, CompletedSteps)
  db --> handler : Commit result
  handler --> controller : NextStepDto(stepKey, number, total)
  controller --> client : 200 OK
  client --> store : Next step
  store --> page : Route to next step; show "Step n of total" (L2-014 AC1)
end
@enduml
