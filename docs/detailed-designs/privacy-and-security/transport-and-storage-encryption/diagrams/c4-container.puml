@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Transport and storage encryption

Person(parent, "Parent", "Opens and tracks an RESP for each child")
System_Boundary(seedlings, "Seedlings") {
  Container(pwa, "Seedlings PWA", "Angular 21, service worker", "Parent-facing progressive web app (frontend/projects/seedling)")
  Container(api, "Seedlings API", "ASP.NET Core, .NET 10", "Controllers, MediatR application layer, domain")
  Container(worker, "Seedlings Worker", ".NET 10 triggered WebJob", "Scheduled daily checks and reminders")
  ContainerDb(db, "Seedlings database", "Azure SQL", "Accounts, cases, intake, audit trail")
  ContainerDb(vault, "Sensitive data vault", "Azure SQL (segregated schema) + Blob Storage, encrypted", "SINs and identity documents, access-logged")
}
Rel(parent, pwa, "Loads from Static Web App", "HTTPS + HSTS")
Rel(pwa, api, "Calls", "JSON/HTTPS, TLS 1.2+, HSTS")
Rel(api, db, "Reads and writes; TDE at rest", "TDS, Encrypt=True, TLS 1.2+")
Rel(api, vault, "Stores ciphertext; TDE and SSE at rest", "TLS 1.2+")
Rel(worker, db, "Reads and writes", "TDS, Encrypt=True, TLS 1.2+")
Rel(worker, vault, "Deletes and exports", "TLS 1.2+")
@enduml
