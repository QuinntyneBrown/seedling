@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Transport and storage encryption

Person(parent, "Parent", "Opens and tracks an RESP for each child")
Person(reviewer, "Human reviewer", "Resolves cases the agent cannot complete")
System(seedlings, "Seedlings", "RESP opening and grant-claiming agent with a PWA front end")
System_Ext(provider, "RESP provider", "No-fee RESP promoter that opens accounts and reports deposits")
System_Ext(esdc, "ESDC", "Employment and Social Development Canada; receives CLB/CESG claims (form SDE 0093)")
System_Ext(foundry, "Microsoft Foundry (Claude)", "Hosts the Claude model the case agent calls")
System_Ext(appinsights, "Application Insights", "Telemetry and logs")

Rel(parent, seedlings, "Uses the PWA over", "HTTPS, TLS 1.2+ only")
Rel(reviewer, seedlings, "Uses the admin app over", "HTTPS, TLS 1.2+ only")
Rel(seedlings, provider, "Submits applications to", "HTTPS")
Rel(seedlings, esdc, "Submits SDE 0093 claims to", "HTTPS")
Rel(seedlings, foundry, "Calls the case agent model on", "HTTPS, managed identity")
Rel(seedlings, appinsights, "Sends redacted telemetry to", "HTTPS")
@enduml
