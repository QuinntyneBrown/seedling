@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Audit trail

Person(parent, "Parent", "Opens and tracks an RESP for each child")
Person(reviewer, "Human reviewer", "Resolves cases the agent cannot complete")
System_Boundary(seedlings, "Seedlings") {
  Container(pwa, "Seedlings PWA", "Angular 21, service worker", "Parent-facing progressive web app (frontend/projects/seedling)")
  Container(admin, "Admin app", "Angular", "Reviewer and operator console (frontend/projects/admin)")
  Container(api, "Seedlings API", "ASP.NET Core, .NET 10", "Controllers, MediatR application layer, domain")
  Container(worker, "Seedlings Worker", ".NET 10 triggered WebJob", "Scheduled daily checks and reminders")
  ContainerDb(db, "Seedlings database", "Azure SQL", "Accounts, cases, intake, audit trail")
}

Rel(parent, pwa, "Opens Activity on a case", "HTTPS")
Rel(reviewer, admin, "Resolves review items", "HTTPS")
Rel(pwa, api, "GET /api/cases/{caseId}/activity", "JSON/HTTPS")
Rel(admin, api, "Reviewer actions", "JSON/HTTPS")
Rel(api, db, "Appends and reads AuditEntry (append-only)", "EF Core")
Rel(worker, db, "Appends AuditEntry for scheduled agent actions", "EF Core")
@enduml
