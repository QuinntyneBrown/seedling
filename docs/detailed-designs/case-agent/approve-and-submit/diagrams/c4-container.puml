@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Approve and submit

Person(parent, "Parent", "Opens and tracks an RESP for each child")
System_Boundary(seedlings, "Seedlings") {
  Container(pwa, "Seedlings PWA", "Angular 21, service worker", "Parent-facing progressive web app (frontend/projects/seedling)")
  Container(api, "Seedlings API", "ASP.NET Core, .NET 10", "Controllers, MediatR application layer, domain")
  ContainerDb(db, "Seedlings database", "Azure SQL", "Cases, prefilled forms, approvals, submissions, audit trail")
  ContainerDb(vault, "Sensitive data vault", "Azure SQL (segregated schema) + Blob Storage, encrypted", "SINs and identity documents, access-logged")
}
System_Ext(provider, "RESP provider", "No-fee RESP promoter that opens accounts and reports deposits")

Rel(parent, pwa, "Opens Approve and send", "HTTPS")
Rel(pwa, api, "GET summary, POST approvals, POST submissions", "JSON/HTTPS")
Rel(api, db, "Reads forms, writes approvals, submissions, audit", "EF Core")
Rel(api, vault, "Reads SINs and documents for the package; logged", "EF Core, Blob SDK")
Rel(api, provider, "Submits only after the approval gate passes", "Protocol <TO SUPPLY>")
@enduml
