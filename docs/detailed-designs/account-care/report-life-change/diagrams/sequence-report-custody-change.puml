@startuml
title UML sequence behaviour — Report a custody change
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as parent
box "Frontend — Seedlings PWA" #E0F2FE
  participant "LifeChangePage" as page
  participant "HttpLifeChangesService (LIFE_CHANGES_SERVICE)" as client
end box
box "Backend — Seedlings API application" #D1FADF
  participant "LifeChangesController" as controller
end box
box "Backend — Seedlings Application and Domain" #ECFDF3
  participant "ReportLifeChangeCommandHandler" as handler
  participant "CustodyChangeProcessor" as proc
  participant "INotificationDispatcher" as dispatch
end box
box "Backend — Seedlings Infrastructure" #FFF4E5
  database "Seedlings database" as db
end box
actor "Human reviewer" as reviewer
parent -> page : Choose custody, pick the child's case, Save
page -> client : report({kind: Custody, caseId, clientRequestId})
client -> controller : POST /api/life-changes
controller -> handler : Send ReportLifeChangeCommand
handler -> db : Load case scoped to current parent (L2-045)
alt case not the parent's
  db --> handler : No row
  handler --> controller : NotFoundException
  controller --> client : 404 ProblemDetails
else owned case
  handler -> proc : ProcessAsync(change, command)
  proc -> db : Add ReviewItem(Reason "CustodyChange") (L2-025 AC4, L2-022)
  proc --> handler : RoutedToReview
  handler -> db : Save LifeChange, audit entry and ReviewItem in one unit of work
  db --> handler : Commit result
  handler -> dispatch : Tell parent "A person is checking this"
  handler --> controller : LifeChangeResultDto
  controller --> client : 201 Created
  client --> page : Result
  page --> parent : "A person is checking this"
  note over reviewer : ReviewItem appears in the admin app queue
end
@enduml
